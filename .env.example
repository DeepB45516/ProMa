# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string (Neon, Render Postgres, local Postgres, etc.)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Any long random string — used to sign login session cookies.
JWT_SECRET=change-this-to-a-long-random-string

# Optional: enables the "Continue with Google" button.
# Create credentials at https://console.cloud.google.com/apis/credentials
# and set the authorized redirect URI to GOOGLE_CALLBACK_URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

NODE_ENV=development
