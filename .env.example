# Docker Compose database. Use letters, digits, underscores, and hyphens in
# POSTGRES_PASSWORD so it is valid inside DATABASE_URL without URL encoding.
POSTGRES_DB=proma
POSTGRES_USER=proma
POSTGRES_PASSWORD=replace-with-a-long-random-password

# App secrets
JWT_SECRET=replace-with-a-long-random-secret
PGPOOL_MAX=5
APP_URL=http://YOUR_ORACLE_PUBLIC_IP
# Comma-separated browser origins permitted to call the API. For Vercel + Render,
# use your Vercel URL for both APP_URL and FRONTEND_URL and enable cross-site cookies.
# FRONTEND_URL=https://your-app.vercel.app
# COOKIE_SAME_SITE=none

# An IP-only HTTP deployment cannot use Secure cookies. Change to true after
# configuring HTTPS on a real domain.
COOKIE_SECURE=false

# Optional email provider configuration
# RESEND_API_KEY=
# SENDER_EMAIL=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=

# Optional Google OAuth. Google OAuth should use an HTTPS domain, not an IP.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=
